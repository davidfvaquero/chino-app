{
  "id": "dialogue-06",
  "title": "坐出租车",
  "titleEn": "Tomar un taxi",
  "topic": "Transporte",
  "level": "hsk1",
  "lines": [
    {
      "speaker": "A",
      "zh": "你好！我去北京饭店。",
      "pinyin": "Nǐ hǎo! Wǒ qù Běijīng Fàndiàn.",
      "en": "¡Hola! Voy al Hotel Pekín."
    },
    {
      "speaker": "B",
      "zh": "好，请坐。",
      "pinyin": "Hǎo, qǐng zuò.",
      "en": "Vale, sube, por favor."
    },
    {
      "speaker": "A",
      "zh": "多少钱？",
      "pinyin": "Duōshao qián?",
      "en": "¿Cuánto cuesta?"
    },
    {
      "speaker": "B",
      "zh": "二十块。",
      "pinyin": "Èrshí kuài.",
      "en": "Veinte yuanes."
    },
    {
      "speaker": "A",
      "zh": "好，谢谢！几分钟？",
      "pinyin": "Hǎo, xièxie! Jǐ fēnzhōng?",
      "en": "Vale, ¡gracias! ¿Cuántos minutos?"
    },
    {
      "speaker": "B",
      "zh": "十分钟。",
      "pinyin": "Shí fēnzhōng.",
      "en": "Diez minutos."
    },
    {
      "speaker": "A",
      "zh": "谢谢！再见！",
      "pinyin": "Xièxie! Zàijiàn!",
      "en": "¡Gracias! ¡Adiós!"
    },
    {
      "speaker": "B",
      "zh": "再见！",
      "pinyin": "Zàijiàn!",
      "en": "¡Adiós!"
    }
  ]
}
