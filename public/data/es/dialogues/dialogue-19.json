{
  "id": "dialogue-19",
  "title": "在教室",
  "titleEn": "En el aula",
  "topic": "Escuela",
  "level": "hsk2",
  "lines": [
    {
      "speaker": "A",
      "zh": "老师，这个题我不懂。",
      "pinyin": "Lǎoshī, zhège tí wǒ bù dǒng.",
      "en": "Profesor, no entiendo esta pregunta."
    },
    {
      "speaker": "B",
      "zh": "哪个题？",
      "pinyin": "Nǎge tí?",
      "en": "¿Cuál?"
    },
    {
      "speaker": "A",
      "zh": "第三个。",
      "pinyin": "Dì sān ge.",
      "en": "La tercera."
    },
    {
      "speaker": "B",
      "zh": "你看这里。",
      "pinyin": "Nǐ kàn zhèli.",
      "en": "Mire aquí."
    },
    {
      "speaker": "A",
      "zh": "老师，我懂了！谢谢您。",
      "pinyin": "Lǎoshī, wǒ dǒng le! Xièxie nín.",
      "en": "¡Ya lo entiendo, profesor! Gracias."
    },
    {
      "speaker": "B",
      "zh": "明天有考试，大家要准备一下。",
      "pinyin": "Míngtiān yǒu kǎoshì, dàjiā yào zhǔnbèi yīxià.",
      "en": "Mañana hay examen, todos deben prepararse."
    },
    {
      "speaker": "A",
      "zh": "考试有几个题？",
      "pinyin": "Kǎoshì yǒu jǐ ge tí?",
      "en": "¿Cuántas preguntas tiene el examen?"
    },
    {
      "speaker": "B",
      "zh": "十个。都在这本书里。",
      "pinyin": "Shí ge. Dōu zài zhè běn shū li.",
      "en": "Diez. Están todas en este libro."
    },
    {
      "speaker": "A",
      "zh": "好，我晚上学习。",
      "pinyin": "Hǎo, wǒ wǎnshang xuéxí.",
      "en": "Vale, estudiaré esta noche."
    },
    {
      "speaker": "B",
      "zh": "有问题再问我。",
      "pinyin": "Yǒu wèntí zài wèn wǒ.",
      "en": "Si tiene dudas, pregúnteme otra vez."
    }
  ]
}
