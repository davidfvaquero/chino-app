{
  "id": "dialogue-23",
  "title": "约朋友",
  "titleEn": "Quedar con un amigo",
  "topic": "Amigos",
  "level": "hsk3",
  "lines": [
    {
      "speaker": "A",
      "zh": "这个周末你有空吗？",
      "pinyin": "Zhège zhōumò nǐ yǒu kòng ma?",
      "en": "¿Estás libre este fin de semana?"
    },
    {
      "speaker": "B",
      "zh": "有啊，怎么了？",
      "pinyin": "Yǒu a, zěnme le?",
      "en": "Sí, ¿qué pasa?"
    },
    {
      "speaker": "A",
      "zh": "我想去看电影，你去吗？",
      "pinyin": "Wǒ xiǎng qù kàn diànyǐng, nǐ qù ma?",
      "en": "Quiero ir al cine, ¿vienes?"
    },
    {
      "speaker": "B",
      "zh": "好啊，几点？",
      "pinyin": "Hǎo a, jǐ diǎn?",
      "en": "Vale, ¿a qué hora?"
    },
    {
      "speaker": "A",
      "zh": "下午三点怎么样？",
      "pinyin": "Xiàwǔ sān diǎn zěnme yàng?",
      "en": "¿Qué tal a las tres de la tarde?"
    },
    {
      "speaker": "B",
      "zh": "三点我有点事儿，四点行吗？",
      "pinyin": "Sān diǎn wǒ yǒu diǎnr shìr, sì diǎn xíng ma?",
      "en": "A las tres tengo algo, ¿a las cuatro vale?"
    },
    {
      "speaker": "A",
      "zh": "行，那四点见。",
      "pinyin": "Xíng, nà sì diǎn jiàn.",
      "en": "Vale, nos vemos a las cuatro."
    },
    {
      "speaker": "B",
      "zh": "好，我们在哪儿见？",
      "pinyin": "Hǎo, wǒmen zài nǎr jiàn?",
      "en": "Bien, ¿dónde nos vemos?"
    },
    {
      "speaker": "A",
      "zh": "就在电影院门口吧。",
      "pinyin": "Jiù zài diànyǐngyuàn ménkǒu ba.",
      "en": "En la puerta del cine."
    },
    {
      "speaker": "B",
      "zh": "没问题，到时见！",
      "pinyin": "Méi wèntí, dào shí jiàn!",
      "en": "Sin problema, ¡hasta entonces!"
    }
  ]
}
