    {
      "hanzi": "怎么去机场？",
      "pinyin": "zěn me qù jī chǎng",
      "english": "¿cómo llego al aeropuerto?"
    },
    {
      "hanzi": "我要买火车票。",
      "pinyin": "wǒ yào mǎi huǒ chē piào",
      "english": "Quiero comprar un billete de tren."
    },
    {
      "hanzi": "几点出发？",
      "pinyin": "jǐ diǎn chū fā",
      "english": "¿a qué hora sale?"
    },
    {
      "hanzi": "这个站在哪里？",
      "pinyin": "zhè ge zhàn zài nǎ lǐ",
      "english": "¿dónde está esta estación?"
    },
    {
      "hanzi": "请带我去车站。",
      "pinyin": "qǐng dài wǒ qù chē zhàn",
      "english": "Por favor, llévame a la estación."
    },
    {
      "hanzi": "飞机晚点了。",
      "pinyin": "fēi jī wǎn diǎn le",
      "english": "El vuelo va con retraso."
    },
    {
      "hanzi": "我的行李丢了。",
      "pinyin": "wǒ de xíng lǐ diū le",
      "english": "He perdido mi equipaje."
    },
    {
      "hanzi": "坐地铁很快。",
      "pinyin": "zuò dì tiě hěn kuài",
      "english": "El metro es rápido."
    },
    {
      "hanzi": "这里到北京多远？",
      "pinyin": "zhè lǐ dào Běi jīng duō yuǎn",
      "english": "¿qué tan lejos está Beijing de aquí?"
    },
    {
      "hanzi": "我走路去。",
      "pinyin": "wǒ zǒu lù qù",
      "english": "Voy caminando."
    }
