  "phrases": [
    {
      "hanzi": "这个多少钱？",
      "pinyin": "zhè ge duō shǎo qián",
      "english": "¿cuánto cuesta esto?"
    },
    {
      "hanzi": "太贵了。",
      "pinyin": "tài guì le",
      "english": "Es demasiado caro."
    },
    {
      "hanzi": "能便宜一点吗？",
      "pinyin": "néng pián yí yì diǎn ma",
      "english": "¿puedes bajar el precio?"
    },
    {
      "hanzi": "我要买这个。",
      "pinyin": "wǒ yào mǎi zhè ge",
      "english": "Me llevo este."
    },
    {
      "hanzi": "我可以试穿吗？",
      "pinyin": "wǒ kě yǐ shì chuān ma",
      "english": "¿puedo probármelo?"
    },
    {
      "hanzi": "有大一点的吗？",
      "pinyin": "yǒu dà yì diǎn de ma",
      "english": "¿tienes una talla más grande?"
    },
    {
      "hanzi": "我不喜欢这个颜色。",
      "pinyin": "wǒ bù xǐ huān zhè ge yán sè",
      "english": "No me gusta este color."
    },
    {
      "hanzi": "请给我一个袋子。",
      "pinyin": "qǐng gěi wǒ yí ge dài zi",
      "english": "Por favor, dame una bolsa."
    },
    {
      "hanzi": "我付现金。",
      "pinyin": "wǒ fù xiàn jīn",
      "english": "Pago en efectivo."
    },
    {
      "hanzi": "收据给我吧。",
      "pinyin": "shōu jù gěi wǒ ba",
      "english": "Dame el recibo, por favor."
    }
  ]
