    {
      "hanzi": "请给我菜单。",
      "pinyin": "qǐng gěi wǒ cài dān",
      "english": "Por favor, dame el menú."
    },
    {
      "hanzi": "我想点菜。",
      "pinyin": "wǒ xiǎng diǎn cài",
      "english": "Quiero pedir."
    },
    {
      "hanzi": "你推荐什么？",
      "pinyin": "nǐ tuī jiàn shén me",
      "english": "¿qué me recomiendas?"
    },
    {
      "hanzi": "这个不辣。",
      "pinyin": "zhè ge bù là",
      "english": "Esto no pica."
    },
    {
      "hanzi": "很好吃！",
      "pinyin": "hěn hǎo chī",
      "english": "¡Está muy rico!"
    },
    {
      "hanzi": "买单，谢谢。",
      "pinyin": "mǎi dān, xiè xie",
      "english": "La cuenta, por favor."
    },
    {
      "hanzi": "我要一份米饭。",
      "pinyin": "wǒ yào yí fèn mǐ fàn",
      "english": "Quiero una ración de arroz."
    },
    {
      "hanzi": "请给我筷子和勺子。",
      "pinyin": "qǐng gěi wǒ kuài zi hé sháo zi",
      "english": "Por favor, dame palillos y una cuchara."
    },
    {
      "hanzi": "这里有人吗？",
      "pinyin": "zhè lǐ yǒu rén ma",
      "english": "¿está ocupado este asiento?"
    },
