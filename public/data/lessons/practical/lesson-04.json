    { "hanzi": "刻", "pinyin": "kè", "english": "quarter (15 minutes)", "example": { "hanzi": "三点一刻", "pinyin": "sān diǎn yī kè", "english": "3:15 (quarter past three)" } },
    { "hanzi": "差", "pinyin": "chà", "english": "lacking; minutes to the hour", "example": { "hanzi": "差五分三点", "pinyin": "chà wǔ fēn sān diǎn", "english": "5 minutes to three (2:55)" } },
