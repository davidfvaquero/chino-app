    { "hanzi": "下午", "pinyin": "xià wǔ", "english": "afternoon", "example": { "hanzi": "下午三点", "pinyin": "xià wǔ sān diǎn", "english": "3 PM" } },
    { "hanzi": "晚上", "pinyin": "wǎn shang", "english": "evening", "example": { "hanzi": "晚上八点", "pinyin": "wǎn shang bā diǎn", "english": "8 PM" } },
    { "hanzi": "中午", "pinyin": "zhōng wǔ", "english": "noon", "example": { "hanzi": "中午十二点", "pinyin": "zhōng wǔ shí èr diǎn", "english": "12 PM (noon)" } },
    { "hanzi": "半夜", "pinyin": "bàn yè", "english": "midnight", "example": { "hanzi": "半夜两点", "pinyin": "bàn yè liǎng diǎn", "english": "2 AM" } },
    { "hanzi": "早", "pinyin": "zǎo", "english": "early", "example": { "hanzi": "早一点", "pinyin": "zǎo yī diǎn", "english": "a bit earlier" } },
    { "hanzi": "晚", "pinyin": "wǎn", "english": "late", "example": { "hanzi": "晚一点", "pinyin": "wǎn yī diǎn", "english": "a bit later" } },
    { "hanzi": "准时", "pinyin": "zhǔn shí", "english": "on time", "example": { "hanzi": "请准时", "pinyin": "qǐng zhǔn shí", "english": "please be on time" } },
    { "hanzi": "迟到", "pinyin": "chí dào", "english": "late (arrive late)", "example": { "hanzi": "不要迟到", "pinyin": "bú yào chí dào", "english": "don't be late" } }
