    { "hanzi": "三", "pinyin": "sān", "english": "three", "example": { "hanzi": "三本书", "pinyin": "sān běn shū", "english": "three books" } },
    { "hanzi": "四", "pinyin": "sì", "english": "four", "example": { "hanzi": "四只猫", "pinyin": "sì zhī māo", "english": "four cats" } },
