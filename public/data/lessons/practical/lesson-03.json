    { "hanzi": "星期四", "pinyin": "xīng qī sì", "english": "Thursday", "example": { "hanzi": "星期四开会", "pinyin": "xīng qī sì kāi huì", "english": "meeting Thursday" } },
    { "hanzi": "星期五", "pinyin": "xīng qī wǔ", "english": "Friday", "example": { "hanzi": "星期五下班早", "pinyin": "xīng qī wǔ xià bān zǎo", "english": "off early Friday" } },
