        { "hanzi": "再见", "english": "goodbye" },
        { "hanzi": "一", "english": "one" }
      ]
    },
    { "type": "order", "prompt": "Put the characters in order to say 'hello'.", "tokens": ["好", "你"], "answer": "你好" },
