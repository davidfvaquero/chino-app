    { "type": "listen", "audio": "你好", "pinyin": "nǐ hǎo", "prompt": "Listen and choose what you hear.", "options": ["你好", "再见", "谢谢"], "answer": "你好" },
    {
      "type": "match",
      "prompt": "Match each word to its meaning.",
      "pairs": [
