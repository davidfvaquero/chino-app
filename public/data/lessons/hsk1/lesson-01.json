    { "hanzi": "五", "pinyin": "wǔ", "english": "five", "example": { "hanzi": "五个人", "pinyin": "wǔ gè rén", "english": "five people" } },
    { "hanzi": "六", "pinyin": "liù", "english": "six", "example": { "hanzi": "六月", "pinyin": "liù yuè", "english": "June" } },
