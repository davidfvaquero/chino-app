{
  "id": "hsk1-10",
  "title": "Describing the world",
  "intro": "Learn words to describe location, time, and everyday actions.",
  "vocabulary": [
    { "hanzi": "有", "pinyin": "yǒu", "english": "have", "example": { "hanzi": "我有时间", "pinyin": "wǒ yǒu shíjiān", "english": "I have time" } },
    { "hanzi": "月", "pinyin": "yuè", "english": "moon; month", "example": { "hanzi": "八月", "pinyin": "bā yuè", "english": "August" } },
    { "hanzi": "在", "pinyin": "zài", "english": "at; on; in; indicates action in progress", "example": { "hanzi": "在北京", "pinyin": "zài Běijīng", "english": "in Beijing" } },
    { "hanzi": "再见", "pinyin": "zàijiàn", "english": "goodbye; see you later", "example": { "hanzi": "明天再见", "pinyin": "míngtiān zàijiàn", "english": "see you tomorrow" } },
    { "hanzi": "怎么", "pinyin": "zěnme", "english": "how?", "example": { "hanzi": "怎么去？", "pinyin": "zěnme qù?", "english": "How to go?" } },
    { "hanzi": "怎么样", "pinyin": "zěnmeyàng", "english": "how about?; how is/was it?", "example": { "hanzi": "怎么样？", "pinyin": "zěnmeyàng?", "english": "How is it?" } },
    { "hanzi": "这", "pinyin": "zhè", "english": "this", "example": { "hanzi": "这是什么？", "pinyin": "zhè shì shénme?", "english": "What is this?" } },
    { "hanzi": "中国", "pinyin": "Zhōngguó", "english": "China", "example": { "hanzi": "我爱中国", "pinyin": "wǒ ài Zhōngguó", "english": "I love China" } },
    { "hanzi": "中午", "pinyin": "zhōngwǔ", "english": "noon; midday", "example": { "hanzi": "中午吃饭", "pinyin": "zhōngwǔ chī fàn", "english": "eat lunch at noon" } },
    { "hanzi": "住", "pinyin": "zhù", "english": "to live; reside; to stop", "example": { "hanzi": "住在北京", "pinyin": "zhù zài Běijīng", "english": "live in Beijing" } },
    { "hanzi": "桌子", "pinyin": "zhuōzi", "english": "table; desk", "example": { "hanzi": "桌子上", "pinyin": "zhuōzi shàng", "english": "on the table" } },
    { "hanzi": "字", "pinyin": "zì", "english": "letter; character", "example": { "hanzi": "汉字", "pinyin": "hànzì", "english": "Chinese character" } },
    { "hanzi": "昨天", "pinyin": "zuótiān", "english": "yesterday", "example": { "hanzi": "昨天很好", "pinyin": "zuótiān hěn hǎo", "english": "Yesterday was good" } },
    { "hanzi": "做", "pinyin": "zuò", "english": "do; make", "example": { "hanzi": "做饭", "pinyin": "zuò fàn", "english": "cook; make food" } },
    { "hanzi": "坐", "pinyin": "zuò", "english": "sit", "example": { "hanzi": "请坐", "pinyin": "qǐng zuò", "english": "please sit down" } }
  ],
  "exercises": [
    { "type": "choose", "prompt": "What does 中国 mean?", "options": ["Japan", "China", "Korea"], "answer": "China" },
    { "type": "choose", "prompt": "Which word means 'yesterday'?", "options": ["明天", "昨天", "今天"], "answer": "昨天" },
    { "type": "listen", "audio": "在桌子上", "pinyin": "zài zhuōzi shàng", "prompt": "Listen and choose what you hear.", "options": ["在桌子上", "坐桌子上", "再桌子上"], "answer": "在桌子上" },
    { "type": "match", "prompt": "Match each word to its meaning.", "pairs": [
      { "hanzi": "有", "english": "have" },
      { "hanzi": "在", "english": "at; in" },
      { "hanzi": "做", "english": "do; make" },
      { "hanzi": "坐", "english": "sit" }
    ]},
    { "type": "order", "prompt": "Make the phrase 'live in Beijing'.", "tokens": ["北京", "住在"], "answer": "住在北京" },
    { "type": "listen", "audio": "怎么去", "pinyin": "zěnme qù", "prompt": "Listen and choose what you hear.", "options": ["怎么去", "怎么样", "怎么走"], "answer": "怎么去" },
    { "type": "choose", "prompt": "What is the difference between 做 and 坐?", "options": ["same meaning", "做=do/make, 坐=sit", "做=sit, 坐=do/make"], "answer": "做=do/make, 坐=sit" },
    { "type": "order", "prompt": "Put the characters in order to say 'see you tomorrow'.", "tokens": ["见", "再", "明天"], "answer": "明天再见" }
  ]
}