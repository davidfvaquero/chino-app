{
  "id": "reading-32",
  "title": "运动",
  "type": "dialogue",
  "topic": "Sports",
  "lines": [
    {
      "speaker": "A",
      "hanzi": "你喜欢运动吗？",
      "pinyin": "Nǐ xǐhuan yùndòng ma?",
      "english": "Do you like sports?"
    },
    {
      "speaker": "B",
      "hanzi": "喜欢。我每天跑步。",
      "pinyin": "Xǐhuan. Wǒ měitiān pǎobù.",
      "english": "Yes. I run every day."
    },
    {
      "speaker": "A",
      "hanzi": "你也会游泳吗？",
      "pinyin": "Nǐ yě huì yóuyǒng ma?",
      "english": "Can you also swim?"
    },
    {
      "speaker": "B",
      "hanzi": "会游泳，但是不太去。",
      "pinyin": "Huì yóuyǒng, dànshì bù tài qù.",
      "english": "I can swim, but I don't go very often."
    },
    {
      "speaker": "A",
      "hanzi": "星期天打篮球吗？",
      "pinyin": "Xīngqītiān dǎ lánqiú ma?",
      "english": "Play basketball on Sunday?"
    },
    {
      "speaker": "B",
      "hanzi": "不打篮球。星期天踢足球。",
      "pinyin": "Bù dǎ lánqiú. Xīngqītiān tīzúqiú.",
      "english": "Don't play basketball. Play soccer on Sunday."
    },
    {
      "speaker": "A",
      "hanzi": "运动对身体很好。",
      "pinyin": "Yùndòng duì shēntǐ hěn hǎo.",
      "english": "Exercise is very good for your body."
    }
  ]
}
