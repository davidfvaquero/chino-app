{
  "id": "dialogue-04",
  "title": "在饭馆",
  "titleEn": "At the restaurant",
  "topic": "Food & drinks",
  "level": "hsk1",
  "lines": [
    {
      "speaker": "A",
      "zh": "你好！请坐。",
      "pinyin": "Nǐ hǎo! Qǐng zuò.",
      "en": "Hello! Please sit down."
    },
    {
      "speaker": "B",
      "zh": "谢谢！有茶吗？",
      "pinyin": "Xièxie! Yǒu chá ma?",
      "en": "Thank you! Do you have tea?"
    },
    {
      "speaker": "A",
      "zh": "有。你想吃什么菜？",
      "pinyin": "Yǒu. Nǐ xiǎng chī shénme cài?",
      "en": "Yes. What would you like to eat?"
    },
    {
      "speaker": "B",
      "zh": "我想吃米饭和菜。",
      "pinyin": "Wǒ xiǎng chī mǐfàn hé cài.",
      "en": "I'd like rice and a dish."
    },
    {
      "speaker": "A",
      "zh": "好。你喝茶吗？",
      "pinyin": "Hǎo. Nǐ hē chá ma?",
      "en": "OK. Would you like tea?"
    },
    {
      "speaker": "B",
      "zh": "不喝，谢谢。我喝水。",
      "pinyin": "Bù hē, xièxie. Wǒ hē shuǐ.",
      "en": "No, thanks. I'll have water."
    },
    {
      "speaker": "A",
      "zh": "好。米饭和菜来了。",
      "pinyin": "Hǎo. Mǐfàn hé cài lái le.",
      "en": "OK. Here's the rice and the dish."
    },
    {
      "speaker": "B",
      "zh": "谢谢！很好。",
      "pinyin": "Xièxie! Hěn hǎo.",
      "en": "Thank you! It's very good."
    },
    {
      "speaker": "A",
      "zh": "不客气！再见！",
      "pinyin": "Bú kèqi! Zàijiàn!",
      "en": "You're welcome! Goodbye!"
    },
    {
      "speaker": "B",
      "zh": "再见！",
      "pinyin": "Zàijiàn!",
      "en": "Goodbye!"
    }
  ]
}
