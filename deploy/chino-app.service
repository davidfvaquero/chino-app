# /home/homelab/.config/systemd/user/chino-app.service
# Install: cp deploy/chino-app.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#          systemctl --user enable --now chino-app
# Serves the active release (…-live/current, a symlink) on 127.0.0.1 only;
# external access is Tailscale's job (see docs/DEPLOY-homelab.md).
[Unit]
Description=Chino App (static PWA server)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/homelab/chino-app
# The app needs node; systemd's user PATH has none, so pin it (nvm lts/*).
Environment=PATH=/home/homelab/.nvm/versions/node/v24.21.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/homelab/.nvm/versions/node/v24.21.0/bin/node scripts/serve.mjs /home/homelab/chino-app-live/current --port 8095 --host 127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
