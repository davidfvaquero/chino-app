{
  "name": "chino-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, offline-first PWA to learn Mandarin Chinese (shell).",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/serve.mjs .",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "data": "node scripts/build-data.mjs",
    "data:dict-es": "node scripts/fix-dict-es.mjs && node scripts/validate-dict-es.mjs && node scripts/build-dict-es-index.mjs",
    "data:sentences-es": "node scripts/build-sentences-es.mjs",
    "data:examples": "node scripts/build-examples.mjs",
    "data:radicals": "node scripts/build-radicals.mjs",
    "data:audio": "sh scripts/audio/run.sh",
    "test:data": "node --test tests/data-sanity.test.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
